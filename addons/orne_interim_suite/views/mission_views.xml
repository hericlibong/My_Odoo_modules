<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Search View (déplacé en premier pour éviter référence forward) -->
    <record id="view_orne_interim_mission_search" model="ir.ui.view">
        <field name="name">orne.interim.mission.search</field>
        <field name="model">orne_interim.mission</field>
        <field name="arch" type="xml">
            <search>
                <field name="state" string="État"/>
                <field name="mission_type" string="Type de mission"/>
                <field name="partner_id" string="Client"/>
                <filter name="filter_received" string="Reçues" domain="[('state','=','received')]"/>
                <filter name="filter_in_progress" string="En cours" domain="[('state','=','in_progress')]"/>
                <filter name="filter_closed" string="Clôturées" domain="[('state','=','closed')]"/>
                <group expand="0" string="Grouper par">
                    <filter name="group_by_state" string="État" context="{'group_by':'state'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by':'mission_type'}"/>
                    <filter name="group_by_partner" string="Client" context="{'group_by':'partner_id'}"/>
                </group>
                <filter name="filter_cancelled" string="Annulées" domain="[('state','=','cancelled')]"/>
            </search>
        </field>
    </record>

    <!-- Action Window -->
    <record id="action_orne_interim_mission" model="ir.actions.act_window">
        <field name="name">Missions d'intérim</field>
        <field name="res_model">orne_interim.mission</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_orne_interim_mission_search"/>
    </record>

    <!-- Tree View -->
    <record id="view_orne_interim_mission_tree" model="ir.ui.view">
        <field name="name">orne.interim.mission.tree</field>
        <field name="model">orne_interim.mission</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'in_progress'"
                  decoration-muted="state == 'closed'"
                  decoration-info="state == 'invoiced'"
                  decoration-danger="state == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mission_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="expected_workers"/>
                <field name="hourly_rate"/>
                <field name="state"/>
                <field name="duration_days"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_orne_interim_mission_form" model="ir.ui.view">
        <field name="name">orne.interim.mission.form</field>
        <field name="model">orne_interim.mission</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="received,qualified,proposed,confirmed,in_progress,closed,invoiced,cancelled" options="{'clickable': false}"/>
                    <button name="action_back_step" string="Revenir" type="object" states="qualified,proposed,confirmed,in_progress,closed" class="btn-secondary"/>
                    <button name="action_cancel" string="Annuler" type="object" states="received,qualified,proposed,confirmed,in_progress,closed" class="btn-secondary"/>
                    <button name="action_qualify" string="Qualifier" type="object" states="received" class="oe_highlight"/>
                    <button name="action_propose" string="Proposer" type="object" states="qualified" class="oe_highlight"/>
                    <button name="action_confirm" string="Confirmer" type="object" states="proposed" class="oe_highlight"/>
                    <button name="action_start" string="Démarrer" type="object" states="confirmed" class="oe_highlight"/>
                    <button name="action_close" string="Clôturer" type="object" states="in_progress" class="oe_highlight"/>
                    <button name="action_invoice_mark" string="Marquer facturée" type="object" states="closed" class="oe_highlight"/>
                    <button name="action_reactivate" string="Réactiver" type="object" states="cancelled" class="oe_highlight"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="ANNULÉE" bg_color="bg-danger"
                            attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                    <widget name="web_ribbon" title="EN COURS" bg_color="bg-info"
                            attrs="{'invisible': [('state', '!=', 'in_progress')]}"/>
                    <widget name="web_ribbon" title="CLÔTURÉE" bg_color="bg-dark"
                            attrs="{'invisible': [('state', '!=', 'closed')]}"/>
                    <widget name="web_ribbon" title="FACTURÉE" bg_color="bg-success"
                            attrs="{'invisible': [('state', '!=', 'invoiced')]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group string="Synthèse mission">
                        <group>
                            <field name="partner_id"/>
                            <field name="mission_type"/>
                            <field name="expected_workers"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end" attrs="{'invisible': [('state', '=', 'in_progress')]}"/>
                            <field name="state" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         attrs="{'invisible': [('state', '!=', 'in_progress')]}">
                        <strong>Date de fin à surveiller :</strong>
                        <field name="date_end" nolabel="1" readonly="1" class="oe_inline"/>
                    </div>
                    <group string="Description de la mission" col="1">
                        <field name="description" nolabel="1"
                               placeholder="Précisez le besoin client, le contexte et les contraintes éventuelles..."/>
                    </group>
                    <notebook>
                        <page string="Demande">
                            <group string="Contexte de la demande">
                                <group>
                                    <field name="partner_id"/>
                                    <field name="mission_type"/>
                                    <field name="expected_workers"/>
                                </group>
                                <group>
                                    <field name="state" readonly="1"/>
                                    <field name="cancel_reason" attrs="{'invisible': [('state', '!=', 'cancelled')]}"/>
                                </group>
                            </group>
                        </page>
                        <page string="Planification">
                            <group string="Période de mission">
                                <group>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                </group>
                                <group>
                                    <field name="duration_days" string="Durée calculée (jours)" readonly="1"/>
                                    <div class="o_form_label text-muted">Calcul automatique à partir des dates de début et de fin.</div>
                                </group>
                            </group>
                        </page>
                        <page string="Facturation">
                            <group>
                                <group>
                                    <field name="hourly_rate" placeholder="0.00"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <!-- Kanban View -->
    <record id="view_orne_interim_mission_kanban" model="ir.ui.view">
        <field name="name">orne.interim.mission.kanban</field>
        <field name="model">orne_interim.mission</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="mission_type"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="expected_workers"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card oe_kanban_color_#{kanban_color}">
                            <div class="oe_kanban_content">
                                <div>
                                    <strong><field name="name"/></strong>
                                    <div>
                                        <field name="partner_id"/>
                                        <field name="mission_type"/>
<span t-if="record.mission_type &amp;&amp; record.mission_type.raw_value == 'btp'" class="badge badge-primary">BTP</span>
                                        <span t-if="record.mission_type &amp;&amp; record.mission_type.raw_value == 'nettoyage'" class="badge badge-info">Nettoyage</span>
                                    </div>
                                    <div>
                                        <field name="date_start"/> → <field name="date_end"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-users" title="Nombre de personnes"/> <field name="expected_workers"/> personnes
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
